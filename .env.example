# Copy this file to .env and fill in the values. Never commit .env.

# Required. The app will not start without it. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Optional. Debug mode is off unless this is true. Turn it on for local
# development so Django shows error details and serves the static files.
DJANGO_DEBUG=true

# Optional. Without it, RAWG search shows a "RAWG isn't configured" message.
# Get a free key from the "Get API Key" link at https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-api-key
